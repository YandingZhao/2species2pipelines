FROM satijalab/seurat:latest

# GITHUB_PAT avoids unauthenticated rate limits (60/hr) during parallel CI builds
# when remotes::install_github() is called. Pass via --build-arg GITHUB_PAT=<token>.
ARG GITHUB_PAT=""
ENV GITHUB_PAT=${GITHUB_PAT}

RUN apt-get update && apt-get install -y --no-install-recommends \
    libhdf5-dev \
    ca-certificates \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/rpy && \
    /opt/rpy/bin/pip install --no-cache-dir \
    anndata==0.10.9 \
    h5py==3.16.0 \
    numpy==1.26.4 \
    scipy==1.14.1

ENV RETICULATE_PYTHON=/opt/rpy/bin/python

RUN R -e "install.packages(c('harmony','data.table','cowplot'), repos='https://cloud.r-project.org')"
RUN R -e "if (!requireNamespace('BiocManager', quietly=TRUE)) install.packages('BiocManager', repos='https://cloud.r-project.org'); BiocManager::install(c('SingleCellExperiment','batchelor','zellkonverter','scran','scuttle'), ask=FALSE, update=FALSE)"
# install_github calls are retried up to 3× (60s sleep) to handle GitHub API
# unauthenticated rate limits (60/hr) when many parallel jobs run simultaneously.
RUN if [ -n "$GITHUB_PAT" ]; then \
      R -e "if (!requireNamespace('remotes',quietly=TRUE)) install.packages('remotes',repos='https://cloud.r-project.org'); remotes::install_github('satijalab/seurat-wrappers')"; \
    else \
      for i in 1 2 3; do \
        R -e "if (!requireNamespace('remotes',quietly=TRUE)) install.packages('remotes',repos='https://cloud.r-project.org'); remotes::install_github('satijalab/seurat-wrappers')" && break || \
        { echo "Attempt $i failed, sleeping 65s for rate limit reset..."; sleep 65; }; \
      done; \
    fi

RUN if [ -n "$GITHUB_PAT" ]; then \
      R -e "if (!requireNamespace('orthogene',quietly=TRUE)) remotes::install_github('neurogenomics/orthogene')"; \
    else \
      for i in 1 2 3; do \
        R -e "if (!requireNamespace('orthogene',quietly=TRUE)) remotes::install_github('neurogenomics/orthogene')" && break || \
        { echo "Attempt $i failed, sleeping 65s..."; sleep 65; }; \
      done; \
    fi

# Feature selection methods (Phase 4)
RUN R -e "BiocManager::install('M3Drop', ask=FALSE, update=FALSE)"
RUN R -e "BiocManager::install('scry',   ask=FALSE, update=FALSE)"
RUN R -e "install.packages(c('scPNMF','singleCellHaystack'), repos='https://cloud.r-project.org')"
RUN for i in 1 2 3; do \
      R -e "remotes::install_github('prabhakarlab/DUBStepR')" && break || \
      { echo "Attempt $i failed, sleeping 65s..."; sleep 65; }; \
    done
RUN R -e "tryCatch(remotes::install_github('LuyiTian/scSEGIndex'), error=function(e) message('scSEGIndex unavailable, skipping: ', e\$message))"

WORKDIR /workspace
